LOG_ON=false
LOG_TYPE='ERROR|INFO'
LOG_PATH='./logs'
CORS=true
PREFIX='api'
VERSION=1
REDIS_TYPE=single
REDIS_URL='localhost:6379'
REDIS_NODE='localhost:6379,'
REDIS_PASS=redis
CACHE_TIME=60000
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=


