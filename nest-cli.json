{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "filenames": ["apps", "lib"]
      }
    },
    "plugins": ["@nestjs/swagger"]
  },
  "monorepo": true,
  "root": "apps/nestjs-aws",
  "projects": {
    "common": {
      "type": "library",
      "root": "lib/common",
      "entryFile": "index",
      "sourceRoot": "lib/common",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json",
        "assets": ["../lib/common/mail/templates/**/*.hbs", "asserts/**/*"]
      }
    },
    "order": {
      "type": "application",
      "root": "apps/order",
      "entryFile": "main",
      "sourceRoot": "apps/order/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order/tsconfig.app.json",
        "assets": ["asserts/**/*"]
      }
    }
  }
}
