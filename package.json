{
  "name": "nestjs-aws",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:auth:dev": "cross-env NODE_ENV=development nest start auth --watch",
    "start:order:dev": "cross-env NODE_ENV=development APP_PORT=3031 nest start order --watch",
    "start:auth:debug": "cross-env NODE_ENV=development nest start --debug --watch auth",
    "start:order:debug": "cross-env NODE_ENV=development APP_PORT=3031 nest start --debug --watch order",
    "start:prod": "cross-env NODE_ENV=development APP_PORT=3031 nest start --debug --watch order",
    "start:auth:prod": "node dist/apps/auth/apps/auth/src/main.js",
    "start:order:prod": "node dist/apps/order/apps/order/src/main.js",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/apps/auth/lib/common/database/data-source.js",
    "migration:revert:prod": "node ./node_modules/typeorm/cli.js migration:revert -d dist/apps/auth/lib/common/database/data-source.js",
    "image:build:auth": "podman build --platform linux/arm64 --format docker --build-arg APP_NAME=auth -t nestjs-auth:latest .",
    "image:build:order": "podman build --platform linux/arm64 --format docker --build-arg APP_NAME=order -t nestjs-order:latest .",
    "aws:init": "bash ./scripts/init-aws-infra.sh",
    "aws:destroy": "bash ./scripts/destroy-aws-infra.sh",
    "aws:deploy": "bash ./scripts/deploy-aws.sh all",
    "aws:push": "bash ./scripts/deploy-aws.sh push",
    "aws:migrate": "bash ./scripts/deploy-aws.sh migrate",
    "aws:rollout": "bash ./scripts/deploy-aws.sh rollout",
    "codebuild:setup": "bash ./scripts/setup-aws-codebuild.sh setup",
    "codebuild:start": "bash ./scripts/setup-aws-codebuild.sh start",
    "codebuild:status": "bash ./scripts/setup-aws-codebuild.sh status",
    "codebuild:destroy": "bash ./scripts/setup-aws-codebuild.sh destroy",
    "quack:create": "bash ./scripts/duckdb-quack-server.sh create",
    "quack:status": "bash ./scripts/duckdb-quack-server.sh status",
    "quack:ssh": "bash ./scripts/duckdb-quack-server.sh ssh",
    "quack:destroy": "bash ./scripts/duckdb-quack-server.sh destroy",
    "lint": "oxlint --type-aware src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --projects \"./apps/nestjs-aws/test/jest-e2e.json\" \"./apps/auth/test/jest-e2e.json\" \"./apps/order/test/jest-e2e.json\"",
    "typeorm": "typeorm-ts-node-commonjs"
  },
  "dependencies": {
    "@keyv/redis": "^6.1.0",
    "@nestjs-modules/ioredis": "^2.3.1",
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/authentication": "^0.1.1",
    "@nestjs/authorization": "^0.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mail": "^0.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "handlebars": "^4.7.10",
    "ioredis": "^5.11.1",
    "keyv": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pg-query-stream": "^4.17.1",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "request-ip": "^3.3.0",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.1.10",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^7.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "swc-loader": "^0.2.7",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "webpack-node-externals": "^3.0.0"
  }
}
